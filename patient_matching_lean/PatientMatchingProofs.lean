import Std

/-!
Patient matching: checked abstract specification, conditional privacy lemmas,
and impossibility results. Generated by make_standalone.py; edit the modular
sources instead. This is NOT an implementation or security proof of SHA-256,
HMAC, Python serialization, MP-SPDZ, transport, or a production deployment.
Use Lean 4.19.0. All cryptographic and refinement obligations remain explicit.
-/


/- ===== Module: Core ===== -/


/-!
# Existing-HMAC matching: an executable abstract specification

`mac` and `encode` are parameters, not implementations of SHA-256 or Python JSON.
The theorems hold for every such function. They therefore establish functional
facts and limitations, but do not establish pseudorandomness or 2PC security.
The source payload used in some proof hypotheses is a logical witness; the
executable `Source` structure does not require A to retain that payload.
-/

set_option autoImplicit false

namespace PatientMatching.Core

universe u v w x

structure Candidate (Data : Type u) where
  uuid : Nat
  data : Data
  deriving DecidableEq, Repr

structure Source (Key : Type v) (Tag : Type w) where
  uuid : Nat
  center : String
  epoch : Nat
  key : Key
  target : Tag
  deriving Repr

variable {Data : Type u} {Key : Type v} {Tag : Type w} {Payload : Type x}

/-- Reconstruct the candidate using the *source* center and source key. -/
def matchCandidate [DecidableEq Tag]
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Source Key Tag) (row : Candidate Data) : Bool :=
  decide (mac source.key (encode row.data source.center) = source.target)

theorem matches_iff_tag_eq [DecidableEq Tag]
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Source Key Tag) (row : Candidate Data) :
    matchCandidate mac encode source row = true ↔
      mac source.key (encode row.data source.center) = source.target := by
  simp [matchCandidate]

theorem equal_payload_matches [DecidableEq Tag]
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Source Key Tag) (row : Candidate Data) (original : Data)
    (targetBound : source.target = mac source.key (encode original source.center))
    (samePayload : encode row.data source.center = encode original source.center) :
    matchCandidate mac encode source row = true := by
  simp [matchCandidate, samePayload, targetBound]

/-- Changing an unbound candidate UUID is invisible to the HMAC comparison. -/
theorem candidate_uuid_substitution [DecidableEq Tag]
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Source Key Tag) (row : Candidate Data) (replacement : Nat) :
    matchCandidate mac encode source { row with uuid := replacement } =
      matchCandidate mac encode source row := rfl

/-- The source UUID is also absent from the patient HMAC input. -/
theorem source_uuid_substitution [DecidableEq Tag]
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Source Key Tag) (row : Candidate Data) (replacement : Nat) :
    matchCandidate mac encode { source with uuid := replacement } row =
      matchCandidate mac encode source row := rfl

/-- An epoch label alone does not authenticate which key was provided. -/
theorem epoch_label_substitution [DecidableEq Tag]
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Source Key Tag) (row : Candidate Data) (replacement : Nat) :
    matchCandidate mac encode { source with epoch := replacement } row =
      matchCandidate mac encode source row := rfl

def Collision (mac : Key → Payload → Tag) (key : Key)
    (left right : Payload) : Prop :=
  left ≠ right ∧ mac key left = mac key right

/-- A tag match entails equal payloads OR an actual collision, not equal persons. -/
theorem match_implies_equal_payload_or_collision [DecidableEq Tag]
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Source Key Tag) (row : Candidate Data) (original : Data)
    (targetBound : source.target = mac source.key (encode original source.center))
    (matched : matchCandidate mac encode source row = true) :
    encode row.data source.center = encode original source.center ∨
      Collision mac source.key (encode row.data source.center)
        (encode original source.center) := by
  classical
  have tagEq := (matches_iff_tag_eq mac encode source row).mp matched
  by_cases same : encode row.data source.center = encode original source.center
  · exact Or.inl same
  · exact Or.inr ⟨same, tagEq.trans targetBound⟩

/-- This conclusion explicitly requires absence of the particular collision. -/
theorem payload_equality_of_match_and_no_collision [DecidableEq Tag]
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Source Key Tag) (row : Candidate Data) (original : Data)
    (targetBound : source.target = mac source.key (encode original source.center))
    (matched : matchCandidate mac encode source row = true)
    (noCollision : ¬ Collision mac source.key (encode row.data source.center)
      (encode original source.center)) :
    encode row.data source.center = encode original source.center := by
  rcases match_implies_equal_payload_or_collision mac encode source row original
      targetBound matched with same | collision
  · exact same
  · exact False.elim (noCollision collision)

def matchingIds [DecidableEq Tag]
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Source Key Tag) (rows : List (Candidate Data)) : List Nat :=
  (rows.filter (matchCandidate mac encode source)).map Candidate.uuid

theorem matchingIds_membership [DecidableEq Tag]
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Source Key Tag) (rows : List (Candidate Data)) (id : Nat) :
    id ∈ matchingIds mac encode source rows ↔
      ∃ row, row ∈ rows ∧ matchCandidate mac encode source row = true ∧ row.uuid = id := by
  simp only [matchingIds, List.mem_map, List.mem_filter]
  constructor
  · rintro ⟨row, ⟨member, matched⟩, sameId⟩
    exact ⟨row, member, matched, sameId⟩
  · rintro ⟨row, member, matched, sameId⟩
    exact ⟨row, ⟨member, matched⟩, sameId⟩

inductive Result where
  | noMatch
  | singleMatch (uuid : Nat)
  | ambiguousMatches
  | abortedOrIncomplete
  | keyEpochUnavailable
  deriving DecidableEq, Repr

/-- Count matched records, retaining duplicate tuples and even repeated UUIDs. -/
def classify : List Nat → Result
  | [] => .noMatch
  | [uuid] => .singleMatch uuid
  | _ :: _ :: _ => .ambiguousMatches

theorem classify_noMatch_iff (ids : List Nat) :
    classify ids = .noMatch ↔ ids = [] := by
  cases ids with
  | nil => simp [classify]
  | cons first tail =>
    cases tail <;> simp [classify]

theorem classify_singleMatch_iff (ids : List Nat) (uuid : Nat) :
    classify ids = .singleMatch uuid ↔ ids = [uuid] := by
  cases ids with
  | nil => simp [classify]
  | cons first tail =>
    cases tail <;> simp [classify]

theorem classify_ambiguous_iff (ids : List Nat) :
    classify ids = .ambiguousMatches ↔ 2 ≤ ids.length := by
  cases ids with
  | nil => simp [classify]
  | cons first tail =>
    cases tail <;> simp [classify]

/-- Ideal completed-batch interface. No computation transcript is modelled here. -/
def run (complete epochAvailable : Bool) (ids : List Nat) : Result :=
  if complete then
    if epochAvailable then classify ids else .keyEpochUnavailable
  else .abortedOrIncomplete

theorem incomplete_is_abort (epochAvailable : Bool) (ids : List Nat) :
    run false epochAvailable ids = .abortedOrIncomplete := rfl

theorem missing_epoch_is_error (ids : List Nat) :
    run true false ids = .keyEpochUnavailable := rfl

theorem run_noMatch_iff (complete epochAvailable : Bool) (ids : List Nat) :
    run complete epochAvailable ids = .noMatch ↔
      complete = true ∧ epochAvailable = true ∧ ids = [] := by
  cases complete <;> cases epochAvailable <;>
    simp [run, classify_noMatch_iff]

theorem run_singleMatch_iff (complete epochAvailable : Bool)
    (ids : List Nat) (uuid : Nat) :
    run complete epochAvailable ids = .singleMatch uuid ↔
      complete = true ∧ epochAvailable = true ∧ ids = [uuid] := by
  cases complete <;> cases epochAvailable <;>
    simp [run, classify_singleMatch_iff]

theorem run_ambiguous_iff (complete epochAvailable : Bool) (ids : List Nat) :
    run complete epochAvailable ids = .ambiguousMatches ↔
      complete = true ∧ epochAvailable = true ∧ 2 ≤ ids.length := by
  cases complete <;> cases epochAvailable <;>
    simp [run, classify_ambiguous_iff]

theorem single_candidate_completeness [DecidableEq Tag]
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Source Key Tag) (row : Candidate Data) (original : Data)
    (targetBound : source.target = mac source.key (encode original source.center))
    (samePayload : encode row.data source.center = encode original source.center) :
    run true true (matchingIds mac encode source [row]) = .singleMatch row.uuid := by
  have matched := equal_payload_matches mac encode source row original targetBound samePayload
  simp [run, matchingIds, matched, classify]

/-- Generic impossibility: identical encodings of distinct people defeat ANY
deterministic fingerprint as an unambiguous person identifier. -/
theorem demographic_identifier_impossible
    {Person : Type u} (encodePerson : Person → Payload)
    (fingerprint : Payload → Tag)
    (homonyms : ∃ p q : Person, p ≠ q ∧ encodePerson p = encodePerson q) :
    ¬ (∀ p q : Person,
      fingerprint (encodePerson p) = fingerprint (encodePerson q) → p = q) := by
  intro identifies
  obtain ⟨p, q, different, sameEncoding⟩ := homonyms
  exact different (identifies p q (congrArg fingerprint sameEncoding))

/-- A two-person witness: identity is the first component, demographics the
second. This is an information countermodel, not a toy cryptographic protocol. -/
theorem concrete_homonyms
    (fingerprint : String → Tag) :
    ∃ p q : Nat × String, p.1 ≠ q.1 ∧ p.2 = q.2 ∧
      fingerprint p.2 = fingerprint q.2 := by
  exact ⟨(1, "same normalized demographics"),
    (2, "same normalized demographics"), by decide, rfl, rfl⟩

/-- Aggregate the match vector without revealing individual ambiguous matches. -/
def summarizeBits (bits : List Bool) : Result :=
  classify ((bits.zipIdx.filter (fun item => item.1)).map (fun item => item.2))

theorem full_vector_exposes_more_than_summary :
    summarizeBits [true, true, false, false] =
      summarizeBits [false, false, true, true] ∧
    ([true, true, false, false] : List Bool) ≠ [false, false, true, true] := by
  decide

/-- There is no function recovering every full vector from the summary alone.
This concerns the abstract summary function; comparator-realizable worlds are
constructed separately in `PatientMatching.Counterexamples`. -/
theorem no_full_vector_reconstructor :
    ¬ ∃ recover : Result → List Bool,
      ∀ bits, recover (summarizeBits bits) = bits := by
  rintro ⟨recover, recovers⟩
  obtain ⟨sameSummary, differentBits⟩ := full_vector_exposes_more_than_summary
  apply differentBits
  exact (recovers _).symm.trans ((congrArg recover sameSummary).trans (recovers _))

end PatientMatching.Core

/- ===== Module: Privacy ===== -/


/-!
# Conditional privacy and the limits of a disclosed match result

This module does not implement, postulate, or prove the security of a 2PC
protocol.  Real executions and a simulator are explicit parameters.  In
particular, `SimulationBound` is a premise that a separate protocol proof must
establish for the implementation and the intended corruption model.

Every execution below uses the same finite coin space `Fin sampleSize`, with
each coin equally likely.  Consequently acceptance counts have a common
denominator.  When `sampleSize > 0`, dividing a count bound by `sampleSize`
gives the corresponding probability bound.  The kernel-checked theorems use
natural-number count inequalities, avoiding an unverified floating-point or
real-number calculation.

The simulator's type restricts its inputs to the corrupt party's own input
and the explicitly permitted leakage.  The real view should include every
observable item claimed to be protected by an instantiation: messages,
outputs, lengths, errors, and any timing information included in its model.
Neither that coverage nor the existence of the simulator follows from the
theorems here.
-/

set_option autoImplicit false

namespace PatientMatching.Privacy

universe uWorld uOwn uLeak uView

/-- Number of equally weighted coins on which a distinguisher accepts.

The explicit `sampleSize` and the dependent type `Fin sampleSize` ensure the
same number of samples is used for both worlds and for the simulator.
-/
def acceptanceCount {View : Type uView} (distinguisher : View → Bool) :
    (sampleSize : Nat) → (Fin sampleSize → View) → Nat
  | 0, _ => 0
  | size + 1, samples =>
      (if distinguisher (samples 0) then 1 else 0) +
        acceptanceCount distinguisher size (fun coin => samples coin.succ)

/-- Symmetric absolute-gap bound, expressed without truncated subtraction. -/
def CountClose (left right error : Nat) : Prop :=
  left ≤ right + error ∧ right ≤ left + error

theorem countClose_symm {left right error : Nat}
    (bound : CountClose left right error) : CountClose right left error :=
  ⟨bound.2, bound.1⟩

theorem countClose_triangle {left middle right errorLeft errorRight : Nat}
    (leftBound : CountClose left middle errorLeft)
    (rightBound : CountClose middle right errorRight) :
    CountClose left right (errorLeft + errorRight) := by
  rcases leftBound with ⟨leftUpper, middleUpper⟩
  rcases rightBound with ⟨middleLower, rightUpper⟩
  constructor <;> omega

/-- A count is bounded by its declared common sample size. -/
theorem acceptanceCount_le {View : Type uView}
    (distinguisher : View → Bool) (sampleSize : Nat)
    (samples : Fin sampleSize → View) :
    acceptanceCount distinguisher sampleSize samples ≤ sampleSize := by
  induction sampleSize with
  | zero => simp [acceptanceCount]
  | succ size inductionHypothesis =>
      have tailBound := inductionHypothesis (fun coin => samples coin.succ)
      simp only [acceptanceCount]
      split <;> omega

/-- If every coin yields a fixed observed bit, its count is exact. -/
theorem acceptanceCount_of_constant {View : Type uView}
    (distinguisher : View → Bool) (sampleSize : Nat)
    (samples : Fin sampleSize → View) (bit : Bool)
    (constant : ∀ coin, distinguisher (samples coin) = bit) :
    acceptanceCount distinguisher sampleSize samples =
      (if bit then sampleSize else 0) := by
  induction sampleSize with
  | zero => cases bit <;> rfl
  | succ size inductionHypothesis =>
      have tailConstant :
          ∀ coin : Fin size,
            distinguisher ((fun index : Fin size => samples index.succ) coin) = bit :=
        fun coin => constant coin.succ
      have tailCount :=
        inductionHypothesis (fun coin => samples coin.succ) tailConstant
      simp only [acceptanceCount]
      rw [constant 0, tailCount]
      cases bit <;> simp [Nat.add_comm]

variable {World : Type uWorld} {OwnInput : Type uOwn}
  {Leakage : Type uLeak} {View : Type uView}

/--
An explicit, conditional finite-game simulation obligation.

This quantifies over *every* Boolean distinguisher.  It is therefore a
statistical finite-model condition, stronger than merely claiming security
against efficient algorithms.  It must not be presented as a proved property
of HMAC, a particular 2PC library, or production executions.

The simulator receives `ownInput world` and `permittedLeakage world`, and no
other component of `world`.  Its sampling space has the same cardinality as
the real execution's sampling space.
-/
def SimulationBound (sampleSize : Nat)
    (ownInput : World → OwnInput)
    (permittedLeakage : World → Leakage)
    (realView : World → Fin sampleSize → View)
    (simulator : OwnInput → Leakage → Fin sampleSize → View)
    (error : Nat) : Prop :=
  ∀ world distinguisher,
    CountClose
      (acceptanceCount distinguisher sampleSize (realView world))
      (acceptanceCount distinguisher sampleSize
        (simulator (ownInput world) (permittedLeakage world)))
      error

/--
Conditional simulation composition: worlds with equal corrupt-party inputs
and equal permitted leakage have real distinguishing-count gap at most
`2 * error`.

There is no assertion here that `simulation` can be constructed for the
deployed system.  The equality hypotheses must cover all deliberately
revealed information, including the match result when it is disclosed.
-/
theorem simulation_implies_same_leakage_bound
    (sampleSize : Nat)
    (ownInput : World → OwnInput)
    (permittedLeakage : World → Leakage)
    (realView : World → Fin sampleSize → View)
    (simulator : OwnInput → Leakage → Fin sampleSize → View)
    (error : Nat)
    (simulation : SimulationBound sampleSize ownInput permittedLeakage
      realView simulator error)
    (leftWorld rightWorld : World)
    (sameOwnInput : ownInput leftWorld = ownInput rightWorld)
    (sameLeakage : permittedLeakage leftWorld = permittedLeakage rightWorld)
    (distinguisher : View → Bool) :
    CountClose
      (acceptanceCount distinguisher sampleSize (realView leftWorld))
      (acceptanceCount distinguisher sampleSize (realView rightWorld))
      (2 * error) := by
  have leftBound := simulation leftWorld distinguisher
  have rightBound := simulation rightWorld distinguisher
  have sameSimulator :
      acceptanceCount distinguisher sampleSize
          (simulator (ownInput leftWorld) (permittedLeakage leftWorld)) =
      acceptanceCount distinguisher sampleSize
          (simulator (ownInput rightWorld) (permittedLeakage rightWorld)) := by
    rw [sameOwnInput, sameLeakage]
  rcases leftBound with ⟨leftUpper, simulatorLeftUpper⟩
  rcases rightBound with ⟨rightUpper, simulatorRightUpper⟩
  constructor <;> omega

/-- Exact correctness of a publicly readable membership bit, for every coin. -/
def ExactMembershipOutput (sampleSize : Nat)
    (realView : World → Fin sampleSize → View)
    (membership : World → Bool)
    (readOutput : View → Bool) : Prop :=
  ∀ world coin, readOutput (realView world coin) = membership world

/--
An exact disclosed output is itself a distinguisher: it accepts on every
coin of a matching world and on no coin of a nonmatching world.
-/
theorem exact_membership_distinguishes
    (sampleSize : Nat)
    (realView : World → Fin sampleSize → View)
    (membership : World → Bool)
    (readOutput : View → Bool)
    (correct : ExactMembershipOutput sampleSize realView membership readOutput)
    (matchingWorld nonmatchingWorld : World)
    (isMatching : membership matchingWorld = true)
    (isNonmatching : membership nonmatchingWorld = false) :
    acceptanceCount readOutput sampleSize (realView matchingWorld) = sampleSize ∧
    acceptanceCount readOutput sampleSize (realView nonmatchingWorld) = 0 := by
  constructor
  · have constant : ∀ coin, readOutput (realView matchingWorld coin) = true := by
      intro coin
      rw [correct matchingWorld coin, isMatching]
    simpa using
      acceptanceCount_of_constant readOutput sampleSize
        (realView matchingWorld) true constant
  · have constant : ∀ coin, readOutput (realView nonmatchingWorld coin) = false := by
      intro coin
      rw [correct nonmatchingWorld coin, isNonmatching]
    simpa using
      acceptanceCount_of_constant readOutput sampleSize
        (realView nonmatchingWorld) false constant

/--
For a nonempty coin space, exact disclosed membership is incompatible with
identical acceptance counts for every distinguisher across opposite worlds.
This includes deterministic execution as the special case `sampleSize = 1`.
-/
theorem exact_membership_cannot_be_perfectly_hidden
    (sampleSize : Nat) (nonemptyCoins : 0 < sampleSize)
    (realView : World → Fin sampleSize → View)
    (membership : World → Bool)
    (readOutput : View → Bool)
    (correct : ExactMembershipOutput sampleSize realView membership readOutput)
    (matchingWorld nonmatchingWorld : World)
    (isMatching : membership matchingWorld = true)
    (isNonmatching : membership nonmatchingWorld = false) :
    ¬ (∀ distinguisher : View → Bool,
      acceptanceCount distinguisher sampleSize (realView matchingWorld) =
      acceptanceCount distinguisher sampleSize (realView nonmatchingWorld)) := by
  intro hidden
  have counts := exact_membership_distinguishes sampleSize realView membership
    readOutput correct matchingWorld nonmatchingWorld isMatching isNonmatching
  have equalCounts := hidden readOutput
  omega

/--
If a proposed simulator is denied the membership result (so its authorised
inputs remain equal across opposite-membership worlds), exact disclosed
membership forces a large error: `sampleSize ≤ 2 * error`.

For a nonempty uniform sample space this means a per-world simulation error
of at least one half is necessary.  To claim useful privacy, disclosed
membership must therefore be part of the permitted leakage, or the output
functionality itself must change.  This is a generic impossibility result;
no assumption about breaking HMAC is needed.
-/
theorem hiding_disclosed_membership_requires_large_error
    (sampleSize : Nat)
    (ownInput : World → OwnInput)
    (permittedLeakage : World → Leakage)
    (realView : World → Fin sampleSize → View)
    (simulator : OwnInput → Leakage → Fin sampleSize → View)
    (error : Nat)
    (simulation : SimulationBound sampleSize ownInput permittedLeakage
      realView simulator error)
    (membership : World → Bool)
    (readOutput : View → Bool)
    (correct : ExactMembershipOutput sampleSize realView membership readOutput)
    (matchingWorld nonmatchingWorld : World)
    (sameOwnInput : ownInput matchingWorld = ownInput nonmatchingWorld)
    (sameLeakage : permittedLeakage matchingWorld = permittedLeakage nonmatchingWorld)
    (isMatching : membership matchingWorld = true)
    (isNonmatching : membership nonmatchingWorld = false) :
    sampleSize ≤ 2 * error := by
  have bound := simulation_implies_same_leakage_bound sampleSize ownInput
    permittedLeakage realView simulator error simulation matchingWorld
    nonmatchingWorld sameOwnInput sameLeakage readOutput
  have counts := exact_membership_distinguishes sampleSize realView membership
    readOutput correct matchingWorld nonmatchingWorld isMatching isNonmatching
  rcases bound with ⟨matchingUpper, nonmatchingUpper⟩
  omega

end PatientMatching.Privacy

/- ===== Module: Workflow ===== -/


/-!
# A concrete, guarded result-acceptance workflow

This module proves properties of an executable acceptance function, not of HMAC,
2PC, signatures, databases, or clinical identity. `Nat` reference fields are
opaque typed-model identifiers; they are not proved cryptographic commitments.
The caller supplies an authorised expected request and immutable row snapshots.
An externally supplied signature verifier has an explicit soundness obligation.
Even an authentic reply need not describe an honest computation: that additional
protocol obligation belongs to the cryptographic implementation.
-/

namespace PatientMatching.Workflow

structure Metadata where
  sessionId : Nat
  sourceCentre : Nat
  receiverCentre : Nat
  audience : Nat
  purpose : Nat
  schema : Nat
  keyEpoch : Nat
  circuit : Nat
  batchRef : Nat
  deriving DecidableEq, Repr

structure SourceRef where
  uuid : Nat
  rowVersion : Nat
  fingerprintRef : Nat
  centre : Nat
  schema : Nat
  keyEpoch : Nat
  deriving DecidableEq, Repr

structure CandidateRef where
  uuid : Nat
  rowVersion : Nat
  payloadRef : Nat
  centre : Nat
  deriving DecidableEq, Repr

structure Request where
  meta : Metadata
  source : SourceRef
  candidates : List CandidateRef
  deriving DecidableEq, Repr

inductive Outcome where
  | single (candidate : CandidateRef)
  | noMatch
  | ambiguous (candidates : List CandidateRef)
  | incomplete
  | epochUnavailable
  deriving DecidableEq, Repr

structure Reply where
  meta : Metadata
  source : SourceRef
  outcome : Outcome
  deriving DecidableEq, Repr

structure Link where
  sessionId : Nat
  source : SourceRef
  candidate : CandidateRef
  deriving DecidableEq, Repr

structure State where
  sourceRows : Nat → Option SourceRef
  candidateRows : Nat → Option CandidateRef
  availableEpochs : List Nat
  usedSessionIds : List Nat
  links : List Link

/-- These are actual structural equalities and snapshot lookups. There is no
    Boolean named `inputsVerified` standing in for record binding. -/
def Checks (verifySignature : Reply → Bool) (expected : Request)
    (state : State) (reply : Reply) (candidate : CandidateRef) : Prop :=
  verifySignature reply = true ∧
  reply.meta = expected.meta ∧
  reply.source = expected.source ∧
  state.sourceRows expected.source.uuid = some expected.source ∧
  state.candidateRows candidate.uuid = some candidate ∧
  candidate ∈ expected.candidates ∧
  expected.source.centre = expected.meta.sourceCentre ∧
  expected.source.schema = expected.meta.schema ∧
  expected.source.keyEpoch = expected.meta.keyEpoch ∧
  candidate.centre = expected.meta.receiverCentre ∧
  expected.meta.keyEpoch ∈ state.availableEpochs ∧
  expected.meta.sessionId ∉ state.usedSessionIds

instance (verifySignature : Reply → Bool) (expected : Request)
    (state : State) (reply : Reply) (candidate : CandidateRef) :
    Decidable (Checks verifySignature expected state reply candidate) := by
  unfold Checks
  infer_instance

def recordLink (expected : Request) (state : State)
    (candidate : CandidateRef) : State :=
  { state with
    usedSessionIds := expected.meta.sessionId :: state.usedSessionIds
    links := ⟨expected.meta.sessionId, expected.source, candidate⟩ :: state.links }

/-- `none` is rejection: it does not update the supplied state. An accepted
    reply adds an edge and consumes the session; it never merges patient rows. -/
def accept (verifySignature : Reply → Bool) (expected : Request)
    (state : State) (reply : Reply) : Option State :=
  match reply.outcome with
  | .single candidate =>
      if Checks verifySignature expected state reply candidate then
        some (recordLink expected state candidate)
      else none
  | _ => none

/-- Complete characterisation of every successful transition. -/
theorem accepted_iff (verifySignature : Reply → Bool) (expected : Request)
    (state next : State) (reply : Reply) :
    accept verifySignature expected state reply = some next ↔
      ∃ candidate, reply.outcome = .single candidate ∧
        Checks verifySignature expected state reply candidate ∧
        recordLink expected state candidate = next := by
  cases ho : reply.outcome <;> simp [accept, ho]

theorem accepted_inputs_are_bound (verifySignature : Reply → Bool)
    (expected : Request) (state next : State) (reply : Reply)
    (h : accept verifySignature expected state reply = some next) :
    reply.meta = expected.meta ∧ reply.source = expected.source ∧
    state.sourceRows expected.source.uuid = some expected.source ∧
    ∃ candidate, reply.outcome = .single candidate ∧
      state.candidateRows candidate.uuid = some candidate ∧
      candidate ∈ expected.candidates := by
  obtain ⟨candidate, ho, hc, _⟩ := (accepted_iff _ _ _ _ _).mp h
  exact ⟨hc.2.1, hc.2.2.1, hc.2.2.2.1,
    candidate, ho, hc.2.2.2.2.1, hc.2.2.2.2.2.1⟩

theorem accepted_context_is_bound (verifySignature : Reply → Bool)
    (expected : Request) (state next : State) (reply : Reply)
    (h : accept verifySignature expected state reply = some next) :
    expected.source.centre = expected.meta.sourceCentre ∧
    expected.source.schema = expected.meta.schema ∧
    expected.source.keyEpoch = expected.meta.keyEpoch ∧
    expected.meta.keyEpoch ∈ state.availableEpochs ∧
    ∃ candidate, reply.outcome = .single candidate ∧
      candidate.centre = expected.meta.receiverCentre := by
  obtain ⟨candidate, ho, hc, _⟩ := (accepted_iff _ _ _ _ _).mp h
  obtain ⟨_, _, _, _, _, _, hcentre, hschema, hepoch, hreceiver, havailable, _⟩ := hc
  exact ⟨hcentre, hschema, hepoch, havailable, candidate, ho, hreceiver⟩

theorem accepted_session_is_fresh (verifySignature : Reply → Bool)
    (expected : Request) (state next : State) (reply : Reply)
    (h : accept verifySignature expected state reply = some next) :
    expected.meta.sessionId ∉ state.usedSessionIds := by
  obtain ⟨_, _, hc, _⟩ := (accepted_iff _ _ _ _ _).mp h
  obtain ⟨_, _, _, _, _, _, _, _, _, _, _, hfresh⟩ := hc
  exact hfresh

theorem accepted_session_is_consumed (verifySignature : Reply → Bool)
    (expected : Request) (state next : State) (reply : Reply)
    (h : accept verifySignature expected state reply = some next) :
    expected.meta.sessionId ∈ next.usedSessionIds := by
  obtain ⟨candidate, _, _, hn⟩ := (accepted_iff _ _ _ _ _).mp h
  rw [← hn]
  simp [recordLink]

/-- Reject any reuse of an already consumed session, even with a different
    request, reply, or verifier. Persistent, atomic state storage is external. -/
theorem used_session_rejected (verifySignature : Reply → Bool)
    (expected : Request) (state : State) (reply : Reply)
    (used : expected.meta.sessionId ∈ state.usedSessionIds) :
    accept verifySignature expected state reply = none := by
  cases ho : reply.outcome <;> simp [accept, ho, Checks, used]

theorem replay_rejected (verifySignature verifySignature' : Reply → Bool)
    (expected expected' : Request) (state next : State) (reply reply' : Reply)
    (h : accept verifySignature expected state reply = some next)
    (sameSession : expected'.meta.sessionId = expected.meta.sessionId) :
    accept verifySignature' expected' next reply' = none := by
  apply used_session_rejected
  rw [sameSession]
  exact accepted_session_is_consumed _ _ _ _ _ h

theorem accepted_rows_unchanged (verifySignature : Reply → Bool)
    (expected : Request) (state next : State) (reply : Reply)
    (h : accept verifySignature expected state reply = some next) :
    next.sourceRows = state.sourceRows ∧
    next.candidateRows = state.candidateRows ∧
    next.availableEpochs = state.availableEpochs := by
  obtain ⟨candidate, _, _, hn⟩ := (accepted_iff _ _ _ _ _).mp h
  rw [← hn]
  exact ⟨rfl, rfl, rfl⟩

theorem accepted_link_has_original_references (verifySignature : Reply → Bool)
    (expected : Request) (state next : State) (reply : Reply)
    (h : accept verifySignature expected state reply = some next) :
    ∃ candidate, reply.outcome = .single candidate ∧
      next.links = ⟨expected.meta.sessionId, expected.source, candidate⟩ :: state.links := by
  obtain ⟨candidate, ho, _, hn⟩ := (accepted_iff _ _ _ _ _).mp h
  exact ⟨candidate, ho, congrArg State.links hn.symm⟩

theorem existing_links_preserved (verifySignature : Reply → Bool)
    (expected : Request) (state next : State) (reply : Reply) (link : Link)
    (h : accept verifySignature expected state reply = some next)
    (old : link ∈ state.links) : link ∈ next.links := by
  obtain ⟨_, _, hn⟩ := accepted_link_has_original_references _ _ _ _ _ h
  rw [hn]
  exact List.mem_cons_of_mem _ old

theorem non_single_rejected (verifySignature : Reply → Bool)
    (expected : Request) (state : State) (reply : Reply)
    (notSingle : ∀ candidate, reply.outcome ≠ .single candidate) :
    accept verifySignature expected state reply = none := by
  cases ho : reply.outcome with
  | single candidate => exact False.elim (notSingle candidate ho)
  | noMatch => simp [accept, ho]
  | ambiguous candidates => simp [accept, ho]
  | incomplete => simp [accept, ho]
  | epochUnavailable => simp [accept, ho]

theorem unavailable_epoch_rejected (verifySignature : Reply → Bool)
    (expected : Request) (state : State) (reply : Reply)
    (unavailable : expected.meta.keyEpoch ∉ state.availableEpochs) :
    accept verifySignature expected state reply = none := by
  cases ho : reply.outcome <;> simp [accept, ho, Checks, unavailable]

/-- Signature authenticity follows only if the external verifier is sound.
    This does not prove that a signer supplied genuine patient data or ran 2PC. -/
theorem accepted_authentic_of_verifier_sound (verifySignature : Reply → Bool)
    (Authentic : Reply → Prop)
    (verifierSound : ∀ reply, verifySignature reply = true → Authentic reply)
    (expected : Request) (state next : State) (reply : Reply)
    (h : accept verifySignature expected state reply = some next) :
    Authentic reply := by
  obtain ⟨_, _, hc, _⟩ := (accepted_iff _ _ _ _ _).mp h
  exact verifierSound reply hc.1

end PatientMatching.Workflow

/- ===== Module: Counterexamples ===== -/


/-!
# Comparator-realizable disclosure and an explicit backend-refinement bridge

The disclosure witness below uses one fixed candidate input and two source
inputs which differ only in their private target.  Its premise is that two
candidate payloads have different tags under the fixed source key and centre.
This premise is not a claim that all distinct payloads have distinct HMACs.

The optional shape theorem shows how equal candidate payload lengths (or other
public shapes) can be required without modelling Python's byte serializer.
Only the public fields represented here are covered; a concrete privacy game
must include all its actual public metadata and observations.

The final theorem couples an accepted reply to the Core computation only under
an explicit backend-refinement premise. Neither signatures nor structural
reference checks establish that premise.  No cryptographic backend is verified
or instantiated by this module.
-/

set_option autoImplicit false

namespace PatientMatching.Counterexamples

universe u v w x z

variable {Data : Type u} {Key : Type v} {Tag : Type w} {Payload : Type x}

/-- One fixed B input: two records per payload, with four distinct UUIDs. -/
def fixedCandidates (left right : Data) : List (Core.Candidate Data) :=
  [⟨1, left⟩, ⟨2, left⟩, ⟨3, right⟩, ⟨4, right⟩]

theorem fixed_candidate_uuids (left right : Data) :
    (fixedCandidates left right).map Core.Candidate.uuid = [1, 2, 3, 4] ∧
    ((fixedCandidates left right).map Core.Candidate.uuid).Nodup := by
  simp [fixedCandidates]

def sourceFor (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Core.Source Key Tag) (data : Data) : Core.Source Key Tag :=
  { source with target := mac source.key (encode data source.center) }

/-- These are the public source fields represented in the Core model. -/
def publicSourceFields (source : Core.Source Key Tag) : Nat × String × Nat :=
  (source.uuid, source.center, source.epoch)

theorem source_context_unchanged
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Core.Source Key Tag) (left right : Data) :
    publicSourceFields (sourceFor mac encode source left) =
      publicSourceFields (sourceFor mac encode source right) ∧
    (sourceFor mac encode source left).key =
      (sourceFor mac encode source right).key := ⟨rfl, rfl⟩

def matchVector [DecidableEq Tag]
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Core.Source Key Tag) (rows : List (Core.Candidate Data)) : List Bool :=
  rows.map (Core.matchCandidate mac encode source)

/-- Both differing vectors are realizable by the actual abstract comparator,
    while B's complete input, A's key, and the modelled public fields stay fixed. -/
theorem realizable_match_vectors [DecidableEq Tag]
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Core.Source Key Tag) (left right : Data)
    (differentTags : mac source.key (encode left source.center) ≠
      mac source.key (encode right source.center)) :
    matchVector mac encode (sourceFor mac encode source left)
      (fixedCandidates left right) = [true, true, false, false] ∧
    matchVector mac encode (sourceFor mac encode source right)
      (fixedCandidates left right) = [false, false, true, true] := by
  simp [matchVector, fixedCandidates, sourceFor, Core.matchCandidate,
    differentTags, Ne.symm differentTags]

/-- A concrete same-summary/different-vector witness with fixed candidate inputs.
    This establishes excess disclosure relative to this aggregate interface;
    it does not instantiate a protocol transcript or security reduction. -/
theorem realizable_aggregate_disclosure [DecidableEq Tag]
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Core.Source Key Tag) (left right : Data)
    (differentTags : mac source.key (encode left source.center) ≠
      mac source.key (encode right source.center)) :
    Core.summarizeBits (matchVector mac encode (sourceFor mac encode source left)
      (fixedCandidates left right)) = .ambiguousMatches ∧
    Core.summarizeBits (matchVector mac encode (sourceFor mac encode source right)
      (fixedCandidates left right)) = .ambiguousMatches ∧
    matchVector mac encode (sourceFor mac encode source left)
      (fixedCandidates left right) ≠
    matchVector mac encode (sourceFor mac encode source right)
      (fixedCandidates left right) := by
  obtain ⟨leftVector, rightVector⟩ :=
    realizable_match_vectors mac encode source left right differentTags
  rw [leftVector, rightVector]
  decide

/-- Instantiate `shape` with encoded byte length when a concrete batch requires
    equal public lengths. That equal-length premise remains explicit. -/
theorem fixed_batch_has_uniform_shape {Shape : Type z}
    (encode : Data → String → Payload) (shape : Payload → Shape)
    (center : String) (left right : Data)
    (sameShape : shape (encode left center) = shape (encode right center)) :
    (fixedCandidates left right).map (fun row => shape (encode row.data center)) =
      List.replicate 4 (shape (encode left center)) := by
  simp [fixedCandidates, ← sameShape]

/-- Forget non-Core reference information only for comparing declared outcomes.
    This function is not a credential or a proof of what a backend executed. -/
def declaredCoreResult : Workflow.Outcome → Core.Result
  | .single candidate => .singleMatch candidate.uuid
  | .noMatch => .noMatch
  | .ambiguous _ => .ambiguousMatches
  | .incomplete => .abortedOrIncomplete
  | .epochUnavailable => .keyEpochUnavailable

/--
If the external backend's result is already proved to refine the Core computation
on these exact inputs, every accepted single reply denotes exactly one matching
list entry, with a complete run and available epoch.

The premise must be established for the actual private inputs, encoding, key,
candidate order, UUID bindings, and execution.  It is deliberately not inferred
from signature authenticity.  The theorem does not establish that the opaque
Workflow references commit to the supplied Core inputs.
-/
theorem accepted_single_is_unique_if_backend_refines [DecidableEq Tag]
    (mac : Key → Payload → Tag) (encode : Data → String → Payload)
    (source : Core.Source Key Tag) (rows : List (Core.Candidate Data))
    (complete epochAvailable : Bool)
    (verifySignature : Workflow.Reply → Bool) (expected : Workflow.Request)
    (state next : Workflow.State) (reply : Workflow.Reply)
    (backendRefinement : declaredCoreResult reply.outcome =
      Core.run complete epochAvailable (Core.matchingIds mac encode source rows))
    (accepted : Workflow.accept verifySignature expected state reply = some next) :
    ∃ candidate, reply.outcome = .single candidate ∧
      complete = true ∧ epochAvailable = true ∧
      Core.matchingIds mac encode source rows = [candidate.uuid] := by
  obtain ⟨candidate, outcome, _, _⟩ :=
    (Workflow.accepted_iff verifySignature expected state next reply).mp accepted
  have singleResult :
      Core.run complete epochAvailable (Core.matchingIds mac encode source rows) =
        .singleMatch candidate.uuid := by
    rw [outcome] at backendRefinement
    simpa [declaredCoreResult] using backendRefinement.symm
  have correct := (Core.run_singleMatch_iff complete epochAvailable
    (Core.matchingIds mac encode source rows) candidate.uuid).mp singleResult
  exact ⟨candidate, outcome, correct⟩

end PatientMatching.Counterexamples

