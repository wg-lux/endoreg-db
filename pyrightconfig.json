{
  "include": [
    "endoreg_db",
    "tests"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.mypy_cache",
    "**/.pytest_cache",
    "**/.ruff_cache",
    ".devenv",
    ".direnv",
    ".git",
    "build",
    "data",
    "dist",
    "docs/build",
    "docs/_build",
    "export",
    "htmlcov",
    "Images",
    "import",
    "lx-data-models",
    "lx-report-generator",
    "rust",
    "storage",
    "endoreg_db/migrations",
    "endoreg_db/**/migrations"
  ],
  "ignore": [
    "endoreg_db/migrations",
    "endoreg_db/**/migrations"
  ],
  "extraPaths": [
    "."
  ],
  "venvPath": ".devenv/state",
  "venv": "venv",
  "pythonVersion": "3.12",
  "pythonPlatform": "Linux",
  "typeCheckingMode": "basic",
  "useLibraryCodeForTypes": true,
  "analyzeUnannotatedFunctions": true,
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "none",
  "reportAttributeAccessIssue": "information",
  "reportArgumentType": "information",
  "reportAssignmentType": "information",
  "reportCallIssue": "information",
  "reportGeneralTypeIssues": "information",
  "reportIndexIssue": "information",
  "reportOperatorIssue": "information",
  "reportOptionalIterable": "information",
  "reportOptionalMemberAccess": "information",
  "reportOptionalOperand": "information",
  "reportOptionalSubscript": "information",
  "reportReturnType": "information",
  "reportTypedDictNotRequiredAccess": "information",
  "reportUnusedImport": "warning",
  "reportUnusedVariable": "warning",
  "reportUnusedClass": "information",
  "reportUnusedFunction": "information",
  "reportUnusedExcept": "warning",
  "reportDuplicateImport": "warning",
  "reportUnreachable": "warning",
  "reportUnsupportedDunderAll": "information",
  "reportPrivateUsage": "none",
  "reportPrivateImportUsage": "none",
  "reportUnknownArgumentType": "none",
  "reportUnknownLambdaType": "none",
  "reportUnknownMemberType": "none",
  "reportUnknownParameterType": "none",
  "reportUnknownVariableType": "none"
}
