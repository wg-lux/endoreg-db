"""Complete exact-HMAC batch; MP-SPDZ v0.4.4 MASCOT mixed computation.

Compile: compile.py -M -X patient_matching_resolver KEY_SIZE LENGTHS_CSV EPOCH_HEX
A inputs key bytes + target tag + request digest; B inputs request digest + payloads.
Public lengths disclose payload lengths. Native arithmetic reveal_to(1) releases
ONE result only to B: 0=no match; 1..N=single index+1; N+1=ambiguous;
N+2=invalid key epoch; N+3=request mismatch. A receives completion only. No intermediate matches open.
Input provenance, UUID association, JSON syntax, and fairness remain external.
"""

from Compiler.GC.types import sbit, sbits, sbitvec
from Compiler.circuit import sha256
from Compiler.library import print_ln_to
from Compiler.types import sint, MemValue

key_size = int(program.args[1])
payload_sizes = tuple(map(int, program.args[2].split(",")))
count = len(payload_sizes)
epoch_hex = program.args[3]
if not (1 <= key_size <= 1024 and all(1 <= size <= 4096 for size in payload_sizes) and 1 <= count <= 100):
    raise ValueError("Synthetic experiment exceeds its public size limits")
if len(epoch_hex) != 64 or any(c not in "0123456789abcdef" for c in epoch_hex):
    raise ValueError("Expected canonical public key-epoch hex")


def private_bytes(owner, size):
    return [bit for _ in range(size) for bit in reversed(
        sbits.get_type(8).get_input_from(owner).bit_decompose())]


def public_bytes(value):
    return [sbit((byte >> shift) & 1) for byte in value for shift in range(7, -1, -1)]


def digest(bits):
    # The library accepts most-significant-bit-first input, returns reversed bits.
    return list(reversed(sha256(sbitvec.from_vec(bits)).v))


def equal(left, right):
    result = sbit(1)
    for a, b in zip(left, right):
        result = result & (1 ^ a ^ b)
    return result


key = private_bytes(0, key_size)
target = private_bytes(0, 32)
context_valid = equal(private_bytes(0, 32), private_bytes(1, 32))
if key_size > 64:
    key = digest(key)
key += [sbit(0)] * (512 - len(key))
ipad = [bit ^ ((0x36 >> (7 - i % 8)) & 1) for i, bit in enumerate(key)]
opad = [bit ^ ((0x5c >> (7 - i % 8)) & 1) for i, bit in enumerate(key)]


def hmac_sha256(message):
    return digest(opad + digest(ipad + message))


epoch_valid = equal(hmac_sha256(public_bytes(b"endoreg-identity-salt-v1")),
                    public_bytes(bytes.fromhex(epoch_hex)))
total = MemValue(sint(0))
selected = MemValue(sint(0))

for index, payload_size in enumerate(payload_sizes):
    matched = sint(equal(hmac_sha256(private_bytes(1, payload_size)), target))
    total.write(total.read() + matched)
    selected.write(matched.if_else(index + 1, selected.read()))

result = (total.read() == 1).if_else(selected.read(),
    (total.read() > 1).if_else(count + 1, 0))
result = sint(epoch_valid).if_else(result, count + 2)
result = sint(context_valid).if_else(result, count + 3)
print_ln_to(1, "LX_MATCH_RESULT=%s", result.reveal_to(1))
print_ln_to(0, "LX_MATCH_COMPLETE")
