# Canonical protected runtime root for deployment-owned data.
# STORAGE_DIR must stay inside this directory.
LX_ANNOTATE_ENCRYPTED_DATA_DIR=./data

# Managed media/artifact storage under the protected root.
# Typical contents: documents, processed videos, frames, model weights.
STORAGE_DIR=./data/storage


ENV_PATH=./.env
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here
CENTER_NAME=university_hospital_wuerzburg
