[Unit]
Description=Endoreg local study server quarantine cleanup dry run
RequiresMountsFor=/var/lib/lx-annotate/encrypted
After=postgresql.service

[Service]
Type=oneshot
User=endoreg
Group=endoreg
WorkingDirectory=/opt/endoreg-db
EnvironmentFile=/etc/endoreg-db/local-study-server.env
Environment=DJANGO_SETTINGS_MODULE=endoreg_db.config.settings.prod
ExecStart=/opt/endoreg-db/venv/bin/python /opt/endoreg-db/manage.py reap_quarantine --older-than-days 30 --dry-run --json
StandardOutput=journal
StandardError=journal
