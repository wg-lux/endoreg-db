[Unit]
Description=Endoreg local study server health check
Wants=network-online.target
RequiresMountsFor=/var/lib/lx-annotate/encrypted
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=endoreg
Group=endoreg
WorkingDirectory=/opt/endoreg-db
EnvironmentFile=/etc/endoreg-db/local-study-server.env
Environment=DJANGO_SETTINGS_MODULE=endoreg_db.config.settings.prod
ExecStart=/opt/endoreg-db/venv/bin/python /opt/endoreg-db/manage.py refresh_audit_ledger_integrity --once --fail-on-non-verified
ExecStart=/opt/endoreg-db/venv/bin/python /opt/endoreg-db/manage.py check_system_health --json
StandardOutput=journal
StandardError=journal
